# ==========================================
# SpotiQuiz — Firebase & Spotify Integration
# ==========================================

# 1. Firebase Authentication & Hosting
# Get these from Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
VITE_FIREBASE_AUTH_DOMAIN=spotiquiz-music.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=spotiquiz-music
VITE_FIREBASE_STORAGE_BUCKET=spotiquiz-music.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# 2. Spotify Web API (OAuth PKCE)
# Get from https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_REDIRECT_URI=https://yourdomain.com/

# 3. Optional Backend WebSocket Endpoint (if hosted separately from Firebase static hosting)
# VITE_WS_URL=wss://yourdomain.com/ws
